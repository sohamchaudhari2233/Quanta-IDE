# ===================================================================
# Quanta IDE - Global Environment Configuration Template
# Copy this file to .env and configure your secret credentials.
# ===================================================================

# Google Cloud OAuth 2.0 Credentials (Google Drive API)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_PROJECT_ID=quanta-ide

# Quanta PC Extension (VS Code & Antigravity)
QUANTA_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
QUANTA_CLIENT_SECRET=your-google-client-secret

# Remote-Control Server Configuration
APP_PASSWORD=choose-a-strong-password-min-16-chars
PORT=3000
TUNNEL_PROVIDER=cloudflare        # Options: cloudflare, ngrok, pinggy, none
NGROK_AUTHTOKEN=your-ngrok-token  # Required if TUNNEL_PROVIDER=ngrok

# Security & Session Settings
SESSION_SECRET=generate-a-strong-random-session-secret-here
AUTH_SALT=generate-a-strong-random-auth-salt-here
ALLOW_LAN_AUTO_TRUST=false       # Keep false for Zero-Trust compliance
REQUIRE_DEVICE_PAIRING=false     # Require desktop approval for new mobile devices

# 2FA / TOTP Settings (Optional RFC 6238)
ENABLE_TOTP=false                # Set true to require TOTP 2FA on login
TOTP_SECRET=your-base32-totp-secret

# Rate Limiting & Proxy Configuration
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
TRUST_PROXY_MODE=auto            # Options: auto, cloudflare, ngrok, true, false
