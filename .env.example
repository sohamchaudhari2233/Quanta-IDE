# ===================================================================
# Quanta IDE - Global Environment Template
# Copy this file to .env and configure your secret credentials.
# ===================================================================

# Google Cloud OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_PROJECT_ID=your-google-project-id

# Quanta PC Extension (VS Code)
QUANTA_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
QUANTA_CLIENT_SECRET=your-google-client-secret

# Quanta Mobile IDE (Vite Frontend)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GEMINI_API_KEY=your-gemini-api-key

# Remote-Control Server
APP_PASSWORD=your-secure-password
TUNNEL_PROVIDER=cloudflare
NGROK_AUTHTOKEN=your-ngrok-authtoken
PORT=3000

